# Copy this file to .env.local and fill in values from
# Supabase dashboard → Project Settings → API (or Data API).
# .env.local is git-ignored; never commit real keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Dedicated Playwright test user (create in Supabase → Authentication → Users).
# No VITE_ prefix on purpose: these must never be bundled into the browser app.
E2E_EMAIL=e2e@sigil.test
E2E_PASSWORD=your-test-user-password
